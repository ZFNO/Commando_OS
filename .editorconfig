# https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = false

# NOTE: end_of_line is deliberately not set. The repo already mixes CRLF (home.html, script.js,
# style.css) and LF (index.html, markdown, dotfiles) and no mass re-encoding is wanted.
# NOTE: indent_style / indent_size are deliberately not set either - the sources mix tabs and
# spaces and are meant to be left exactly as they are.

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
